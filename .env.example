# Copia questo file in ".env" e compila i valori.
# Usa SOLO la chiave "anon" (pubblica) di Supabase, MAI la service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=la-tua-anon-key

# Opzionale: indirizzo del sito, usato per l'anteprima quando condividi il link.
# Su Vercel viene preso in automatico; compilalo solo se usi un dominio tuo.
# VITE_SITE_URL=https://www.tuodominio.it
